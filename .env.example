# TCP Brain local configuration example.
# Do not put production secrets in this file.

TCP_BRAIN_HOST=127.0.0.1
TCP_BRAIN_PORT=8091
TCP_BRAIN_DETECTION_STATUS_DIR=/srv/tcp/knowledge/detection

TCP_BRAIN_DB_DSN=
TCP_BRAIN_DB_HOST=127.0.0.1
TCP_BRAIN_DB_PORT=5432
TCP_BRAIN_DB_NAME=tcp_brain
TCP_BRAIN_DB_USER=tcp_brain
TCP_BRAIN_DB_PASSWORD=change-me
TCP_BRAIN_DB_PASS=

OPENAI_API_KEY=change-me
TCP_BRAIN_UPSTREAM_URL=https://api.openai.com/v1/chat/completions
TCP_BRAIN_UPSTREAM_MODEL=gpt-4.1-mini-2025-04-14
TCP_BRAIN_COST_PER_IA_CALL_BRL=0.01

TCP_BRAIN_SMOKE_BASE_URL=https://www.escossio.com/tcp-brain
TCP_BRAIN_SMOKE_TIMEOUT=15
